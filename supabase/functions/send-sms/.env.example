# Qareeb Supabase Edge Function Secrets: send-sms
# Set these in your Supabase Project via Supabase Dashboard or CLI:
# supabase secrets set KEY=VALUE --project-ref bhoyijskowtwskfnllfo

# 1. SMS Provider Selector
# Options: 'sendpk' (default) | 'veevotech' | 'aisms'
SMS_PROVIDER=sendpk

# 2. If using SendPK (sendpk.com)
SENDPK_USERNAME=your_sendpk_username
SENDPK_PASSWORD=your_sendpk_password_or_api_key
SENDPK_SENDER_ID=Qareeb

# 3. If using Veevo Tech (veevotech.com)
VEEVO_HASH=your_veevotech_api_hash
VEEVO_SENDER_NUM=Qareeb

# 4. If using AiSMS (for staging/testing)
AISMS_API_KEY=your_aisms_api_key
AISMS_SENDER_ID=Qareeb

# 5. Supabase Auth Hook Verification Secret
# Generated when you create the hook in Supabase Dashboard > Authentication > Hooks > Send SMS Hook
# Looks like: v1,whsec_xxxxxxxxxxxxxxxxxxxx
SEND_SMS_HOOK_SECRET=
