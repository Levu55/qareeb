# Copy to .env.local and fill in. Never commit real values.

# Supabase project the app talks to (Project Settings > API). Both are public browser values;
# all access control is enforced by row level security in the database.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Optional, only used when the app runs inside Google AI Studio (injected there at runtime).
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
